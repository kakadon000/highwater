// The desktop widget: a small translucent tracker that floats over the desktop.
// It mirrors the cards' readings — one row per provider, the same numbers, the
// same tones — and each row wears the provider's real mark: the actual company
// logo, in full colour, on a glass badge, exactly as a hover card would wear
// it. Everything it shows is published by `src/widget.rs`; the window itself is
// frameless, skipped by the taskbar, and dragged by its header. The bar under
// every row is the provider's own colour, so the card reads as the companies
// it tracks at any glance.

import { Theme } from "theme.slint";
import { BrandLogos } from "logos.slint";

export struct WidgetRow {
    name: string,
    // The name's first letter, for the chip when no mark exists: Slint strings
    // have no way to take one themselves.
    initial: string,
    // The provider's mark, the same one the card wears, and whether there is one.
    mark: image,
    has-mark: bool,
    // The card's own words: "12.3k / 50k", a balance, or the daemon's word.
    value: string,
    // The reading as a percentage, already spelled: "42%".
    percent: string,
    has-gauge: bool,
    gauge-percent: float,
    // 0 normal, 1 warning, 2 danger.
    gauge-tone: int,
    gauge-blocked: bool,
}

export global WidgetDesk {
    // The chip's background: the brand's own colour where it has one worth
    // wearing, and transparent where it has none — the chip then falls back to
    // the palette's quiet grey and the mark to the theme's own ink.
    public pure function tint-for(name: string) -> color {
        if (name == "Claude" || name == "Anthropic") { return #D97757; }
        if (name == "OpenAI" || name == "Codex") { return #10A37F; }
        if (name == "Gemini") { return #4285F4; }
        if (name == "Google" || name == "Antigravity") { return #4285F4; }
        if (name == "DeepSeek") { return #4D6BFE; }
        if (name == "Grok" || name == "xAI") { return #4B4B55; }
        if (name == "Groq") { return #F55036; }
        if (name == "Mistral") { return #FF7000; }
        if (name == "MiniMax") { return #F23F5D; }
        if (name == "Perplexity") { return #20808D; }
        if (name == "Alibaba") { return #FF6A00; }
        if (name == "Qwen") { return #615CED; }
        if (name == "Poe") { return #5D5CDE; }
        if (name == "ClinePass") { return #3B82F6; }
        if (name == "Deepgram") { return #13EF93; }
        if (name == "IBM" || name == "IBM Bob") { return #0F62FE; }
        if (name == "Z.ai") { return #6C6CFF; }
        return #00000000;
    }

    // The card goes translucent only where the window's surface keeps its alpha:
    // over the system's acrylic on Windows 10/11, over the compositor elsewhere.
    in property <bool> acrylic;
    // The surface really does keep its alpha — set from the platform, because an
    // opaque surface has no corners of its own to show and no room for a gutter.
    in property <bool> translucent;
    in-out property <bool> connected;
    in property <[WidgetRow]> rows;
    // The user's opacity for the card, 50..=100.
    in-out property <int> opacity;
    // The user's size for the card: 0.9 compact, 1.0 default, 1.15 large.
    in-out property <float> scale: 1.0;

    // The ✕ hides the widget and turns the setting off, exactly as the
    // preferences switch would. A click anywhere else brings the window up.
    callback hide();
    callback open-main();
    // A header drag ended: the position is saved so the next launch opens here.
    callback moved();
}

// The same track, fill and tone rules the cards' QuotaBar draws, at a third of
// the thickness a card can afford. The fill is the provider's own colour where
// it has one; the tones still win, because a warning is never on brand.
component WidgetBar inherits Rectangle {
    in property <float> percent;
    in property <int> tone;
    in property <bool> blocked;
    in property <string> name;
    height: 3.5px;
    border-radius: self.height / 2;

    property <color> brand: BrandLogos.brand-for(root.name);
    property <color> fill: tone == 2 ? Theme.error-bg
        : tone == 1 ? Theme.warning-bg
        : root.brand == #00000000 ? Theme.accent : root.brand;

    Rectangle {
        border-radius: self.height / 2;
        background: Theme.ink(0.12);
    }
    if root.percent > 0: Rectangle {
        width: max(self.height, min(root.percent / 100 * parent.width, parent.width));
        border-radius: self.height / 2;
        background: root.fill;
        opacity: root.blocked ? 0.5 : 1;
        animate width { duration: 300ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    }
}

// One provider's mark: the real logo, full colour, on a glass badge — the way
// a hover card wears it. Where the company has no real mark bundled, the chip
// falls back to the tinted square and symbolic mark the cards already use.
component ProviderBadge inherits Rectangle {
    in property <string> name;
    in property <string> initial;
    in property <image> mark;
    in property <bool> has-mark;
    width: 27px * WidgetDesk.scale;
    height: 27px * WidgetDesk.scale;
    border-radius: self.height / 2;
    background: Theme.dark ? #ffffff14 : #ffffff;
    border-width: 1px;
    border-color: Theme.dark ? #ffffff24 : #00000617;
    drop-shadow-blur: Theme.dark ? 0px : 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: #0f172a26;

    if BrandLogos.has-logo(root.name): Image {
        source: BrandLogos.logo-for(root.name);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px * WidgetDesk.scale;
        height: 16px * WidgetDesk.scale;
    }
    if !BrandLogos.has-logo(root.name): Rectangle {
        width: 19px * WidgetDesk.scale;
        height: 19px * WidgetDesk.scale;
        border-radius: 6px * WidgetDesk.scale;
        background: WidgetDesk.tint-for(root.name) == #00000000
            ? Theme.ink(0.14) : WidgetDesk.tint-for(root.name);

        if root.has-mark: Image {
            source: root.mark;
            colorize: #FFFFFF;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 12px * WidgetDesk.scale;
            height: 12px * WidgetDesk.scale;
        }
        if !root.has-mark: Text {
            text: root.initial;
            color: #FFFFFF;
            font-size: Theme.body * WidgetDesk.scale;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component WidgetWindow inherits Window {
    title: "Highwater";
    no-frame: true;
    preferred-width: root.card-width + 2 * root.gutter;
    // Ten pixels of clear window on every side keep the card's shadow inside
    // the surface; none where the surface cannot clear to transparent, because
    // the window would otherwise draw a black frame around an opaque card.
    preferred-height: root.card-height + 2 * root.gutter;
    // The compositor can only show the desktop through the card's corners when
    // the window itself clears to transparent.
    background: transparent;
    default-font-family: "Rubik";
    default-font-size: Theme.body;

    property <bool> translucent: WidgetDesk.translucent;
    property <length> gutter: self.translucent ? 10px : 0px;
    property <length> card-radius: self.translucent ? 22px : 0px;

    property <length> pad: 13px * WidgetDesk.scale;
    property <length> row-height: 44px * WidgetDesk.scale;
    property <length> header-height: 38px * WidgetDesk.scale;
    property <length> footer-height: 26px * WidgetDesk.scale;

    // Header, one row per visible provider, the footer, and the card's padding.
    property <length> card-width: 282px * WidgetDesk.scale;
    property <length> card-height: root.header-height + root.pad
        + max(WidgetDesk.rows.length, 1) * root.row-height
        + root.footer-height + root.pad - 4px;

    card := Rectangle {
        x: root.gutter;
        y: root.gutter;
        width: parent.width - 2 * root.gutter;
        height: root.card-height;
        background: WidgetDesk.acrylic
            ? Theme.window-bg-acrylic.transparentize((100 - clamp(WidgetDesk.opacity, 50, 100)) / 260)
            : Theme.window-bg;
        border-radius: root.card-radius;
        border-width: root.translucent ? 1px : 0px;
        border-color: Theme.dark ? #ffffff1f : #ffffffc0;
        drop-shadow-blur: root.translucent ? 22px : 0px;
        drop-shadow-offset-y: root.translucent ? 8px : 0px;
        drop-shadow-color: #0a14283f;

        VerticalLayout {
            padding: root.pad;
            padding-bottom: root.pad - 4px;

            // The grip: dragging the card by its header, the way the main
            // window is dragged by its own.
            header := Rectangle {
                height: root.header-height;
                WindowMoveArea {
                    TouchArea {
                        moved => {
                            WidgetDesk.moved();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px * WidgetDesk.scale;

                    Image {
                        source: @image-url("icons/widget-logo.png");
                        width: 21px * WidgetDesk.scale;
                        height: 21px * WidgetDesk.scale;
                    }
                    Text {
                        text: WidgetDesk.connected ? "Highwater" : "Highwater · waiting";
                        color: Theme.fg;
                        font-size: Theme.body * 1.05 * WidgetDesk.scale;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    // The daemon's pulse: green while readings land, amber while
                    // the card waits for its first one.
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: self.height / 2;
                        background: WidgetDesk.connected ? Theme.success : Theme.warning;
                    }
                    close := Rectangle {
                        width: 22px * WidgetDesk.scale;
                        height: 22px * WidgetDesk.scale;
                        border-radius: self.height / 2;
                        background: close-touch.has-hover ? Theme.ink(0.12) : transparent;
                        animate background { duration: 100ms; }
                        Image {
                            source: @image-url("icons/window-close-symbolic.svg");
                            width: 12px;
                            height: 12px;
                            colorize: Theme.fg.transparentize(0.35);
                        }
                        close-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                WidgetDesk.hide();
                            }
                        }
                    }
                }
            }

            for row in WidgetDesk.rows: row-rect := Rectangle {
                height: root.row-height;
                opacity: row.gauge-blocked ? 0.5 : 1.0;
                open-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        WidgetDesk.open-main();
                    }
                }
                hover := Rectangle {
                    border-radius: 11px;
                    background: open-touch.has-hover ? Theme.ink(0.06) : transparent;
                    animate background { duration: 100ms; }
                }
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 12px;
                    padding-bottom: 6px;
                    spacing: 10px * WidgetDesk.scale;
                    // A plain wrapper: layouts center their children, and the
                    // badge wants to sit a shade high, over its bar.
                    Rectangle {
                        ProviderBadge {
                            name: row.name;
                            initial: row.initial;
                            mark: row.mark;
                            has-mark: row.has-mark;
                            y: (parent.height - self.height) / 2 - 2px;
                        }
                    }
                    // The name over the reading, the way a hover card spells it.
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: row.name;
                            color: Theme.fg;
                            font-size: Theme.body * WidgetDesk.scale;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.value;
                            color: Theme.ink(0.52);
                            font-size: Theme.caption * 0.92 * WidgetDesk.scale;
                            overflow: elide;
                        }
                    }
                    Rectangle {}
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: row.percent;
                            color: row.gauge-tone == 2 ? Theme.error-bg
                                : row.gauge-tone == 1 ? Theme.warning-bg
                                : Theme.fg;
                            font-size: Theme.body * 1.05 * WidgetDesk.scale;
                            font-weight: 800;
                            horizontal-alignment: right;
                        }
                        // The state at a glance: green while there is room,
                        // amber as it thins, red at the wall.
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: self.height / 2;
                            x: (parent.width - self.width) / 2;
                            background: row.gauge-tone == 2 ? Theme.error-bg
                                : row.gauge-tone == 1 ? Theme.warning-bg
                                : Theme.success;
                        }
                    }
                }
                if row.has-gauge: WidgetBar {
                    x: 41px * WidgetDesk.scale;
                    y: parent.height - self.height - 5px;
                    width: parent.width - 55px * WidgetDesk.scale;
                    percent: row.gauge-percent;
                    tone: row.gauge-tone;
                    blocked: row.gauge-blocked;
                    name: row.name;
                }
            }

            if WidgetDesk.rows.length == 0: Rectangle {
                height: root.row-height;
                Text {
                    text: WidgetDesk.connected ? "No providers configured." : "Waiting for Highwater…";
                    color: Theme.ink(0.55);
                    font-size: Theme.caption * WidgetDesk.scale;
                    vertical-alignment: center;
                }
            }

            // The card's own footer: how many companies it tracks, and whether
            // the daemon is answering.
            footer := Rectangle {
                height: root.footer-height;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: WidgetDesk.rows.length == 0 ? "nothing tracked"
                            : WidgetDesk.rows.length == 1 ? "1 provider"
                            : "{WidgetDesk.rows.length} providers";
                        color: Theme.ink(0.45);
                        font-size: Theme.caption * 0.92 * WidgetDesk.scale;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle {}
                    Text {
                        text: WidgetDesk.connected ? "live" : "waiting";
                        color: Theme.ink(0.45);
                        font-size: Theme.caption * 0.92 * WidgetDesk.scale;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
