        if (name == "Mistral") { return @image-url("logos/mistral.png"); }
        if (name == "Perplexity") { return @image-url("logos/perplexity.png"); }
        if (name == "Poe") { return @image-url("logos/poe.png"); }
        if (name == "Deepgram") { return @image-url("logos/deepgram.png"); }
        if (name == "Alibaba Coding Plan") { return @image-url("logos/alibaba.png"); }
        if (name == "ElevenLabs") { return @image-url("logos/elevenlabs.png"); }
        if (name == "Notion") { return @image-url("logos/notion.png"); }
