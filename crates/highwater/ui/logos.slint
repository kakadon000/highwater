        if (name == "GitHub Copilot") { return @image-url("logos/githubcopilot.png"); }
        if (name == "Warp") { return @image-url("logos/warp.png"); }
        if (name == "OpenCode") { return @image-url("logos/opencode.png"); }
        if (name == "OpenRouter") { return @image-url("logos/openrouter.png"); }
        if (name == "Kilo") { return @image-url("logos/kilocode.png"); }
        if (name == "Kilo Pass") { return @image-url("logos/kilocode.png"); }
        if (name == "Augment") { return @image-url("logos/augment.png"); }
        if (name == "Fireworks") { return @image-url("logos/fireworks.png"); }
        if (name == "Factory") { return @image-url("logos/factory.png"); }
        if (name == "DeepInfra") { return @image-url("logos/deepinfra.png"); }
        if (name == "Manus") { return @image-url("logos/manus.png"); }
        if (name == "NanoGPT") { return @image-url("logos/nanogpt.png"); }
