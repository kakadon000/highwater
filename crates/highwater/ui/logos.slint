        if (name == "OpenCode") { return true; }
        if (name == "OpenRouter") { return true; }
        if (name == "Kilo") { return true; }
        if (name == "Kilo Pass") { return true; }
        if (name == "Augment") { return true; }
        if (name == "Fireworks") { return true; }
        if (name == "Factory") { return true; }
        if (name == "DeepInfra") { return true; }
        if (name == "Manus") { return true; }
        if (name == "NanoGPT") { return true; }
        if (name == "Venice") { return true; }
        if (name == "Qoder") { return true; }
        if (name == "T3 Chat") { return true; }
        if (name == "StepFun") { return true; }
        if (name == "Cerebras") { return true; }
