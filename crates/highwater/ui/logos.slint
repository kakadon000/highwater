// Real brand marks for the desktop widget's rows, one PNG per provider that
// ships with a genuine logo (43 providers carry one; the rest wear the
// symbolic mark the cards use). Generated by scripts/gen_logos_slint.py —
// the sources live in scripts/build_brand_assets.py's table. The bar colour
// is the provider's own, the same one the badge wears, so a row reads as the
// company it is at any size.

export global BrandLogos {
    // The provider's real mark, full colour, no recolouring.
    public pure function logo-for(name: string) -> image {
        if (name == "Claude") { return @image-url("logos/claude.png"); }
        if (name == "Anthropic") { return @image-url("logos/claude.png"); }
        if (name == "Codex") { return @image-url("logos/codex.png"); }
        if (name == "OpenAI") { return @image-url("logos/openai.png"); }
        if (name == "Antigravity") { return @image-url("logos/antigravity.png"); }
